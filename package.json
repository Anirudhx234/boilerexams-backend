{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "postinstall": "npx prisma generate",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint --fix .",
    "format": "npx prettier --write .",
    "reset": "npx prisma migrate reset",
    "seed": "node prisma/seed.ts",
    "build": "rimraf dist && tsc --build",
    "dev": "dotenv -e .env.development npm run nodemon",
    "nodemon": "nodemon --config config/nodemon.json",
    "starthotfix": "cross-env NODE_ENV=development node --loader ts-node/esm server.ts",
    "deploy": "npx prisma migrate deploy",
    "start": "npm run deploy && node dist/server.js",
    "dev:remote": "npm run deploy && cross-env NODE_ENV=development REMOTE=enabled node dist/server.js",
    "prod": "npm run deploy && cross-env NODE_ENV=production REMOTE=enabled node dist/server.js",
    "bun": "bun server.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.391.0",
    "@aws-sdk/lib-storage": "^3.391.0",
    "@prisma/client": "^5.3.1",
    "axios": "^1.4.0",
    "connect-pg-simple": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.4",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.8",
    "passport": "^0.6.0",
    "passport-discord": "^0.1.4",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "prisma": "^5.3.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "url": "^0.11.1"
  },
  "devDependencies": {
    "@types/express-session": "^1.17.8",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "eslint": "^8.43.0",
    "nodemon": "^3.0.1",
    "prettier": "3.2.4"
  }
}
