{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "deploy": "npx prisma migrate deploy",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint --fix .",
    "postinstall": "npx prisma generate",
    "reset": "dotenv -e .env npx prisma migrate reset",
    "seed": "node prisma/seed.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "dev": "nodemon --config config/nodemon.json",
    "dev:remote": "pm2 start config/ecosystem.config.cjs --only \"development\"",
    "start": "cross-env NODE_ENV=production ts-node-esm server.ts",
    "prod": "pm2 start config/ecosystem.config.cjs --only \"production\""
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.391.0",
    "@aws-sdk/lib-storage": "^3.391.0",
    "@prisma/client": "^5.3.1",
    "axios": "^1.4.0",
    "connect-pg-simple": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.4",
    "node-cache": "^5.1.2",
    "passport": "^0.6.0",
    "passport-discord": "^0.1.4",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^5.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "url": "^0.11.1"
  },
  "devDependencies": {
    "@types/express-session": "^1.17.8",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.8",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "eslint": "^8.43.0",
    "nodemon": "^3.0.1"
  }
}
