{
    "compilerOptions": {
        "sourceMap": true,
        "outDir": "dist",
        "strict": true,
        "lib": ["esnext"],
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "module": "NodeNext",
        "target": "ES2022",
        "typeRoots": ["./types"],
    },
}
