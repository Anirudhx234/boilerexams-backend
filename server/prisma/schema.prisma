generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id              String     @id @default(uuid())
  name            String     @unique
  subject         String     @default("")
  abbreviation    String     @default("")
  number          Int        @default(0)
  backgroundColor String     @default("")
  graphicLink     String     @default("")
  published       Boolean    @default(false)
  exams           Exam[]
  questions       Question[]
  semesters       Semester[] @relation("CourseToSemester")
  topics          Topic[]    @relation("CourseToTopic")

  @@unique([subject, number])
  @@unique([abbreviation, number])
  @@unique([abbreviation, number, published])
}

model Exam {
  id         String     @id @default(uuid())
  number     Int
  published  Boolean    @default(false)
  courseId   String
  semesterId String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questions  Question[]

  @@unique([number, courseId, semesterId])
  @@unique([number, courseId, semesterId, published])
}

model Topic {
  id        String     @id @default(uuid())
  name      String     @unique
  courses   Course[]   @relation("CourseToTopic")
  questions Question[] @relation("QuestionToTopic")
}

model Question {
  id                 String         @id @default(uuid())
  number             Int
  body               String
  correctChoiceIndex Int
  submissions        Int[]          @default([])
  solutionVideoLink  String         @default("")
  courseId           String
  examId             String
  course             Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exam               Exam           @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  topics             Topic[]        @relation("QuestionToTopic")
  answerChoices      AnswerChoice[]
  resources          Resource[]

  // @@unique([examId, number])
}

model AnswerChoice {
  id          String     @id @default(uuid())
  choiceIndex Int
  body        String
  questionId  String
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources   Resource[]

  @@unique([questionId, choiceIndex])
}

model Resource {
  id             String        @id @default(uuid())
  type           ResourceType
  image          Image?
  code           Code?
  questionId     String?
  answerChoiceId String?
  question       Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  answerChoice   AnswerChoice? @relation(fields: [answerChoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum ResourceType {
  IMAGE
  CODE
}

model Image {
  id         String   @id @default(uuid())
  key        String
  url        String
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Code {
  id         String   @id @default(uuid())
  language   Language
  code       String
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum Language {
  C
  JAVA
}

model Semester {
  id      String   @id @default(uuid())
  season  Season
  year    Int
  exams   Exam[]
  courses Course[] @relation("CourseToSemester")

  @@unique([season, year])
}

enum Season {
  SPRING
  SUMMER
  FALL
}

model CourseRequest {
  id       String @id
  subject  String
  course   String
  requests Int    @default(1)
}
