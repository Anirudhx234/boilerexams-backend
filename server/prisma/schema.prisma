generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DATABASE_URL")
  url       = env("DATABASE_URL_BOUNCER")
}

model Course {
  id              String     @id @default(uuid())
  name            String     @unique
  backgroundColor String     @default("")
  secondaryColor  String     @default("")
  graphicLink     String     @default("")
  number          Int
  published       Boolean    @default(false)
  subject         String
  abbreviation    String
  exams           Exam[]
  questions       Question[]
  semesters       Semester[] @relation("CourseToSemester")
  topics          Topic[]    @relation("CourseToTopic")
  users           User[]     @relation("CourseToUser")

  @@unique([subject, number])
  @@unique([abbreviation, number])
  @@unique([abbreviation, number, published])
}

model Exam {
  id         String     @id @default(uuid())
  number     Int
  courseId   String
  semesterId String
  published  Boolean    @default(false)
  pdfId      String     @default("")
  pdfKey     String     @default("")
  pdfLink    String     @default("")
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@unique([number, courseId, semesterId])
  @@unique([number, courseId, semesterId, published])
}

model Topic {
  id        String     @id @default(uuid())
  name      String     @unique
  courses   Course[]   @relation("CourseToTopic")
  questions Question[] @relation("QuestionToTopic")
}

model Question {
  id                   String         @id @default(uuid())
  examId               String
  number               Int
  body                 String
  courseId             String
  solutionVideoLink    String         @default("")
  correctChoiceIndices Int[]
  published            Boolean        @default(false)
  answerChoices        AnswerChoice[]
  course               Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam                 Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  resources            Resource[]
  submissions          Submission[]
  topics               Topic[]        @relation("QuestionToTopic")
}

model AnswerChoice {
  id          String     @id @default(uuid())
  choiceIndex Int
  body        String
  questionId  String
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  resources   Resource[]

  @@unique([questionId, choiceIndex])
}

model Resource {
  id             String        @id @default(uuid())
  answerChoiceId String?
  questionId     String?
  type           ResourceType
  code           Code?
  image          Image?
  answerChoice   AnswerChoice? @relation(fields: [answerChoiceId], references: [id], onDelete: Cascade)
  question       Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Image {
  id         String   @id @default(uuid())
  key        String
  url        String
  resourceId String   @unique
  altText    String   @default("")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model Code {
  id         String   @id @default(uuid())
  language   Language
  code       String
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model Submission {
  id                    String   @id @default(uuid())
  correct               Boolean
  timeStarted           DateTime
  timeEnded             DateTime
  timeSpent             Int
  videoStartTime        DateTime
  videoEndTime          DateTime
  timeSpentVideo        Int
  questionId            String
  modalEndTime          DateTime @default(now())
  modalStartTime        DateTime @default(now())
  modalTotalTime        Int
  osFamily              String
  selectedChoiceIndices Int[]
  question              Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Semester {
  id      String   @id @default(uuid())
  season  Season
  year    Int
  exams   Exam[]
  courses Course[] @relation("CourseToSemester")

  @@unique([season, year])
}

model Webhook {
  id        String @id
  token     String @unique
  name      String @unique
  avatar    String
  channelId String
}

model CourseRequest {
  id           String @id @default(uuid())
  subject      String
  requests     Int    @default(1)
  abbreviation String
  name         String @unique
  number       Int
}

model User {
  id             String      @id @default(uuid())
  name           String?
  email          String?     @unique
  profilePicture String?
  role           Role        @default(USER)
  accountType    AccountType
  accountId      String?     @unique
  courses        Course[]    @relation("CourseToUser")
}

model Session {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

enum AccountType {
  DISCORD
  GOOGLE
}

enum ResourceType {
  IMAGE
  CODE
}

enum Language {
  C
  JAVA
}

enum Season {
  SPRING
  FALL
  SUMMER
}

enum Role {
  USER
  CONTENT
  ADMIN
}
