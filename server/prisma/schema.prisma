generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id              String     @id @default(uuid())
  name            String     @unique
  subject         String
  abbreviation    String
  number          Int
  backgroundColor String     @default("")
  graphicLink     String     @default("")
  published       Boolean    @default(false)
  exams           Exam[]
  questions       Question[]
  semesters       Semester[]
  topics          Topic[]
  users           User[]

  @@unique([subject, number])
  @@unique([abbreviation, number])
  @@unique([abbreviation, number, published])
}

model Exam {
  id         String     @id @default(uuid())
  number     Int
  published  Boolean    @default(false)
  courseId   String
  semesterId String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questions  Question[]

  @@unique([number, courseId, semesterId])
  @@unique([number, courseId, semesterId, published])
}

model Topic {
  id        String     @id @default(uuid())
  name      String     @unique
  courses   Course[]
  questions Question[]
}

model Question {
  id                   String         @id @default(uuid())
  number               Int
  body                 String
  correctChoiceIndices Int[]
  solutionVideoLink    String         @default("")
  courseId             String
  examId               String
  course               Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exam                 Exam           @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  topics               Topic[]
  answerChoices        AnswerChoice[]
  resources            Resource[]
  submissions          Submission[]

  // @@unique([examId, number])
}

model AnswerChoice {
  id          String     @id @default(uuid())
  choiceIndex Int
  body        String
  questionId  String
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources   Resource[]

  @@unique([questionId, choiceIndex])
}

model Resource {
  id             String        @id @default(uuid())
  type           ResourceType
  image          Image?
  code           Code?
  questionId     String?
  answerChoiceId String?
  question       Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  answerChoice   AnswerChoice? @relation(fields: [answerChoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum ResourceType {
  IMAGE
  CODE
}

model Image {
  id         String   @id @default(uuid())
  key        String
  url        String
  altText    String   @default("")
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Code {
  id         String   @id @default(uuid())
  language   Language
  code       String
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum Language {
  C
  JAVA
}

model Submission {
  id                  String   @id @default(uuid())
  correct             Boolean
  indeces             Int[]
  timeStarted         DateTime
  timeEnded           DateTime
  videoWatched        Boolean
  timeSpent           Int
  videoStartTime      DateTime
  videoEndTime        DateTime
  timeSpentVideo      Int
  reflectionStartTime DateTime @default(now())
  reflectionEndTime   DateTime @default(now())
  questionId          String
  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Semester {
  id      String   @id @default(uuid())
  season  Season
  year    Int
  exams   Exam[]
  courses Course[]

  @@unique([season, year])
}

enum Season {
  SPRING
  SUMMER
  FALL
}

model Webhook {
  id        String @id
  token     String @unique
  name      String @unique
  avatar    String
  channelId String
}

model CourseRequest {
  id           String @id @default(uuid())
  name         String @unique
  subject      String
  abbreviation String
  number       Int
  requests     Int    @default(1)
}

model Account {
  id                String  @id @default(uuid())
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_in        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  expires      DateTime
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum Role {
  USER
  CONTENT
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  courses       Course[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
