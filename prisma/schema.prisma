generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_BOUNCER")
  directUrl = env("DATABASE_URL")
}

model Course {
  id           String       @id @default(uuid())
  abbreviation String
  number       Int
  name         String
  subject      String
  color        String?
  disclaimer   String?
  studyModes   StudyMode[]
  flags        Int
  events       Event[]
  exams        Exam[]
  feedback     Feedback[]
  questions    Question[]
  topics       Topic[]
  resources    Resource[]
  users        User[]       @relation("CourseToUser")
  stats        Json?
  CustomExam   CustomExam[]

  @@unique([abbreviation, number])
}

model Exam {
  id         String     @id @default(uuid())
  number     Int
  year       Int
  season     Season
  disclaimer String?
  courseId   String
  flags      Int
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  feedback   Feedback[]
  questions  Question[]
  resources  Resource[]
  stats      Json?

  @@unique([number, year, season, courseId])
}

model CustomExam {
  id           String     @id @default(uuid())
  data         Json
  name         String
  author       String
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[] @relation("CustomExamToQuestion")
  createdAt    DateTime   @default(now())
  referencedAt DateTime   @default(now())
  stats        Json?

  @@unique([name, courseId])
}

model Question {
  id            String            @id @default(uuid())
  type          QuestionType
  data          Json
  number        Int
  disclaimer    String?
  examId        String
  courseId      String
  parentId      String?
  flags         Int
  feedback      Feedback[]
  explanation   Explanation?
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam          Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  parent        Question?         @relation("QuestionToQuestion", fields: [parentId], references: [id], onDelete: Cascade)
  children      Question[]        @relation("QuestionToQuestion")
  topics        QuestionToTopic[]
  submissions   Submission[]
  resources     Resource[]
  answerChoices AnswerChoice[]
  customExams   CustomExam[]      @relation("CustomExamToQuestion")
  stats         Json?

  @@unique([number, examId, parentId])
}

model Explanation {
  id         String     @id @default(uuid())
  body       String?
  questionId String     @unique
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  resources  Resource[]
}

model AnswerChoice {
  id         String     @id @default(uuid())
  index      Int
  body       String?
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  resources  Resource[]
  stats      Json?

  @@unique([index, questionId])
}

model Submission {
  id             String       @id @default(uuid())
  type           QuestionType
  userSolution   Json?
  correct        Boolean
  timeStarted    DateTime
  timeEnded      DateTime
  timeSpent      BigInt
  timeSpentVideo BigInt
  timeSpentModal BigInt
  osFamily       String?
  questionId     String?
  question       Question?    @relation(fields: [questionId], references: [id]) // SetNull needs to be added
}

model Resource {
  id             String        @id @default(uuid())
  type           ResourceType
  data           Json
  courseId       String?
  examId         String?
  questionId     String?
  explanationId  String?
  applicationId  String?       @unique
  answerChoiceId String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam           Exam?         @relation(fields: [examId], references: [id], onDelete: Cascade)
  question       Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  explanation    Explanation?  @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  application    Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  answerChoice   AnswerChoice? @relation(fields: [answerChoiceId], references: [id], onDelete: Cascade)
  customExamId   String?
}

model Topic {
  id        String            @id @default(uuid())
  name      String
  courseId  String
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuestionToTopic[]
  stats     Json?

  @@unique([name, courseId])
}

model Feedback {
  id           String         @id @default(uuid())
  type         FeedbackType
  status       FeedbackStatus @default(OPEN)
  data         Json
  userId       String?
  courseId     String?
  examId       String?
  questionId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam         Exam?          @relation(fields: [examId], references: [id], onDelete: Cascade)
  question     Question?      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])
  customExamId String?
}

model CourseRequest {
  id           String @id @default(uuid())
  abbreviation String
  number       Int
  name         String
  subject      String
  count        Int    @default(1)

  @@unique([abbreviation, number])
}

model Application {
  id      String         @id @default(uuid())
  status  FeedbackStatus @default(OPEN)
  name    String
  email   String
  content String
  year    String
  resume  Resource?
}

model Event {
  id          String    @id @default(uuid())
  title       String?
  description String?
  type        EventType
  start       DateTime
  end         DateTime
  location    String?
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([location, start])
}

model User {
  id             String        @id @default(uuid())
  role           Role          @default(USER)
  name           String?
  email          String?       @unique
  profilePicture String?
  accountId      String?       @unique
  accountType    AccountType
  feedback       Feedback[]
  localAccount   LocalAccount?
  courses        Course[]      @relation("CourseToUser")
}

model LocalAccount {
  id       String @id @default(uuid())
  password Bytes
  salt     Bytes
  userId   String @unique
  User     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
}

model QuestionToTopic {
  questionId String
  topicId    String
  number     Int      @default(autoincrement())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([questionId, topicId])
  @@unique([number, topicId])
  @@index([number])
}

enum QuestionType {
  PARENT
  MULTIPLE_CHOICE
  FREE_RESPONSE
  SHORT_ANSWER
  FILL_IN_BLANK
}

enum ResourceType {
  LOGO
  IMAGE
  VIDEO
  LONG_VIDEO
  CODE
  PDF
}

enum AccountType {
  DISCORD
  GOOGLE
  LOCAL
}

enum FeedbackType {
  BUG_REPORT
  QUESTION_REPORT
  FEATURE_REQUEST
  VIDEO_FEEDBACK
}

enum EventType {
  EXAM
  FINAL
  CUSTOM
}

enum Role {
  USER
  CONTENT
  GRAPHIC
  PROFESSOR
  ADMIN
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
}

enum StudyMode {
  EXAM
  TIMED_EXAM
  TOPIC
}

enum FeedbackStatus {
  OPEN
  CLOSED
  DELETED
}
