generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DATABASE_URL")
  url       = env("DATABASE_URL_BOUNCER")
}

// Models

model Course {
  id           String      @id @default(uuid())
  abbreviation String
  number       Int
  name         String
  subject      String
  color        String?
  disclaimer   String?
  topics       Topic[]
  modes        StudyMode[]
  exams        Exam[]
  questions    Question[]
  users        User[]      @relation("CourseToUser")
  events       Event[]
  graphic      Resource?
  flags        Int

  @@unique([abbreviation, number])
}

model Exam {
  id         String     @id @default(uuid())
  number     Int
  year       Int
  season     Season
  disclaimer String?
  courseId   String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions  Question[]
  pdf        Resource?
  flags      Int

  @@unique([number, year, season, courseId])
}

model Question {
  id          String       @id @default(uuid())
  type        QuestionType
  data        Json
  number      Int
  disclaimer  String?
  examId      String
  courseId    String
  parentId    String?
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent      Question?    @relation("QuestionToQuestion", fields: [parentId], references: [id])
  children    Question[]   @relation("QuestionToQuestion")
  topics      Topic[]      @relation("QuestionToTopic")
  resources   Resource[]   @relation("QuestionToResource")
  submissions Submission[]
  feedback    Feedback[]
  flags       Int
}

model Submission {
  id             String       @id @default(uuid())
  type           QuestionType
  data           Json
  correct        Boolean
  timeStarted    DateTime
  timeEnded      DateTime
  timeSpent      BigInt
  timeSpentVideo BigInt
  timeSpentModal BigInt
  questionId     String
  osFamily       String
  question       Question     @relation(fields: [questionId], references: [id], onDelete: NoAction)
}

model Resource {
  id            String       @id @default(uuid())
  type          ResourceType
  data          Json
  examId        String?      @unique
  courseId      String?      @unique
  applicationId String?      @unique
  exam          Exam?        @relation(fields: [examId], references: [id], onDelete: Cascade)
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questions     Question[]   @relation("QuestionToResource")
}

model Topic {
  id        String     @id @default(uuid())
  name      String // Not unique because some topics may transcend course
  courseId  String     @unique
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[] @relation("QuestionToTopic")
}

model Feedback {
  id         String         @id @default(uuid())
  type       FeedbackType
  status     FeedbackStatus
  data       Json
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Application {
  id      String    @id @default(uuid())
  name    String
  email   String
  content String
  year    String
  resume  Resource?
}

model Event {
  id          String    @id @default(uuid())
  title       String?
  description String?
  type        EventType
  start       DateTime
  end         DateTime
  location    String?
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([location, start])
}

model User {
  id             String        @id @default(uuid())
  role           Role          @default(USER)
  name           String?
  email          String?       @unique
  profilePicture String?
  accountId      String?       @unique
  accountType    AccountType
  localAccount   LocalAccount?
  courses        Course[]      @relation("CourseToUser")
  feedbackId     String?
}

model LocalAccount {
  id       String @id @default(uuid())
  userId   String @unique
  password Bytes
  salt     Bytes
  User     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

// Enums

enum QuestionType {
  MULTIPLE_CHOICE
  FREE_RESPONSE
  SHORT_ANSWER
  FILL_IN_BLANK
}

enum ResourceType {
  IMAGE
  VIDEO
  CODE
  PDF
}

enum AccountType {
  DISCORD
  GOOGLE
  LOCAL
}

enum FeedbackType {
  BUG_REPORT
  CONTENT_REPORT
  FEATURE_REQUEST
  VIDEO_FEEDBACK
}

enum EventType {
  EXAM
  FINAL
  CUSTOM
}

enum Role {
  USER
  CONTENT
  PROFESSOR
  ADMIN
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
}

enum Language {
  C
  PYTHON
}

enum StudyMode {
  EXAM
  TIMED_EXAM
  TOPIC
}

enum FeedbackStatus {
  OPEN
  CLOSED
}
